# Copy to .env and fill in. Never commit .env.
BULWARK_ENV=development
BULWARK_LOG_LEVEL=INFO
BULWARK_GATEWAY_API_KEY=replace-with-a-long-random-secret
BULWARK_GATEWAY_PORT=8080
BULWARK_DASHBOARD_PORT=3000

# Upstream provider (OpenAI-compatible or Ollama)
BULWARK_UPSTREAM_BASE_URL=https://api.openai.com/v1
BULWARK_UPSTREAM_PROVIDER=openai-compatible
BULWARK_UPSTREAM_API_KEY=

# Infrastructure
BULWARK_DATABASE_URL=postgresql+asyncpg://bulwark:bulwark@postgres:5432/bulwark
BULWARK_REDIS_URL=redis://redis:6379/0

# Docker Compose database credentials (local only)
POSTGRES_USER=bulwark
POSTGRES_PASSWORD=bulwark
POSTGRES_DB=bulwark

# M3 gateway controls
BULWARK_REQUESTS_PER_MINUTE=60
BULWARK_RESPONSE_TAIL_BUFFER_CHARS=256

# M5 hardening (optional)
BULWARK_MAX_REQUEST_BYTES=1048576
# Require "Authorization: Bearer <token>" on /metrics when set.
BULWARK_METRICS_TOKEN=
